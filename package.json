{
  "name": "the-eagletn-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "turbo dev",
    "dev:client": "pnpm --filter client dev",
    "dev:livreur": "pnpm --filter livreur dev",
    "dev:partner": "pnpm --filter partner dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "lint-staged": {
    "apps/client/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --fix"
    ]
  },
  "type": "module"
}
